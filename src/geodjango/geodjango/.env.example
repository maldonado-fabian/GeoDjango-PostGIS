# Copiar como ".env" en este mismo directorio (junto a settings.py). Sin este
# archivo, Django falla con "settings.DATABASES is improperly configured" —
# hallazgo de la validación de portabilidad (2026-09-08): docker-compose.yml
# define POSTGRES_HOST/PORT/DB/USER/PASSWORD para los contenedores, pero
# settings.py lee DATABASE_* — nombres distintos, no alcanza con copiarlos tal
# cual.
#
# Los valores de abajo son los que usa docker-compose.yml por defecto para
# desarrollo local; si cambiaste las credenciales de postgis ahí, reflájalo acá.

DATABASE_ENGINE=django.contrib.gis.db.backends.postgis
DATABASE_NAME=GRD_Docker
DATABASE_USER=postgres
DATABASE_PASSWORD=izipizi123
DATABASE_HOST=postgis
DATABASE_PORT=5432
